class Solution {
public:
    int trap(vector<int>& height) {
        int n = height.size();
        //vector<int>left;
       // vector<int>right;
        vector<int>water;
        int answer = 0;
        vector<int> left(n);
        left[0] = height[0];
        for (int i = 1; i < n; i++) {
            left[i] = max(left[i - 1], height[i]);
        }

        vector<int> right(n);
        right[n - 1] = height[n - 1];
        for (int j = n - 2; j >= 0; j--) {
            right[j] = max(right[j + 1], height[j]);
        }

        for(int k = 0; k<n; k+=1){
            int minHeight = min(left[k], right[k]);
            if(minHeight < 0){
                water.push_back(0);
            }
            else {
                water.push_back(minHeight - height[k]);
            }
        }
        for(int m = 0; m<water.size(); m+=1){
            answer += water[m];
        }
        return answer;
    }
};
