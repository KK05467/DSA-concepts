class Solution {
public:
    int maxFreqSum(string s) {
        vector<int> count1(26, 0);
        string vowels = "aeiou";
        int maxVowel = 0;
        int maxConsonant = 0;

        for (char ch : s) {
            count1[ch - 'a']++;
        }

        for (int i = 0; i < 26; i++) {
            if (count1[i] == 0) continue;
            char c = 'a' + i;
            if (vowels.find(c) != string::npos)
                maxVowel = max(maxVowel, count1[i]);
            else
                maxConsonant = max(maxConsonant, count1[i]);
        }
        return maxVowel + maxConsonant;
    }
};
