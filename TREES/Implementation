#include<bits/stdc++.h>
using namespace std;

class Node{
    public:
    int data;
    Node *left;
    Node *right;
    
    //constructor
    Node(int value){
        data = value;
        right = left = NULL;
    }
};

int main() {
    int x;
    cin>>x;
    
    int first, second;
    
    queue<Node*>q;
    Node *root = new Node(x);
    
    q.push(root);
    while(!q.empty()) {
        Node *temp = q.front();
        q.pop();
        
        if(!(cin>>first)) break;   //left child
        if(first!= -1){
            temp->left = new Node(first);
            q.push(temp->left);
        }
        
        if(!(cin>>second)) break;   //Right child
        if(second!= -1){
            temp->right = new Node(second);
            q.push(temp->right); 
        }
    }
    return 0;
}
